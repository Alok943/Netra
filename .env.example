# Copy this file to `.env` and fill in real values. `.env` is gitignored.
# These are read ONLY by the backend (server/ and api/); never by frontend code.

GEMINI_API_KEY=
TYPESAFE_API_KEY=

# Live-capable Gemini model
GEMINI_LIVE_MODEL=gemini-3.8-live

# Local dev API server port (Vite proxies /api to it)
API_PORT=8787
